if(NOT PS5_PAYLOAD_SDK)
	message(FATAL_ERROR "PS5_PAYLOAD_SDK is not set: export it and use a ps5-* preset")
endif()
foreach(_lib libc++.a libc++abi.a libunwind.a)
	if(NOT EXISTS "${PS5_PAYLOAD_SDK}/target/lib/${_lib}")
		message(FATAL_ERROR "SDK lacks ${_lib}: install a full ps5-payload-sdk release (v0.41+) or run its libcxx.sh")
	endif()
endforeach()
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "[Cc]lang")
	message(FATAL_ERROR "OrangeHUD must be built with clang! CompilerID: ${CMAKE_CXX_COMPILER_ID}")
endif()

include_directories(SYSTEM "${PS5_PAYLOAD_SDK}" "${PS5_PAYLOAD_SDK}/include")
set(ORANGE_TARGET_FLAGS --target=x86_64-sie-ps5 -DPPR -DPS5 -ffile-prefix-map=${PROJECT_SOURCE_DIR}=.)
